{%- comment %} dns-prefetch {% endcomment %}
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

{%- comment %} canonical link {% endcomment -%}
{%- if prev -%}
    <link rel="prev" href="{{ prev.url | absolute_url }}">
{%- endif -%}

{%- if next -%}
    <link rel="next" href="{{ next.url | absolute_url }}">
{%- endif -%}

<link rel="canonical" href="{{ schema_surl }}">

{%- comment %} favicon icon {%- endcomment %}
<link rel="shortcut icon" type="image/x-icon" href="{{ '/assets/images/favicon.ico' | relative_url }}">
{%- comment %} alternate {%- endcomment %}
<link rel="icon" type="image/png" href="{{ '/assets/images/favicon-16x16.png' | relative_url }}" sizes="16x16">
<link rel="icon" type="image/png" href="{{ '/assets/images/favicon-32x32.png' | relative_url }}" sizes="32x32">
<link rel="icon" type="image/png" href="{{ '/assets/images/favicon-64x64.png' | relative_url }}" sizes="64x64">

{%- comment %} apple-touch-icon {%- endcomment %}
<link rel="apple-touch-icon" href="{{ '/assets/images/apple-touch-icon.png' | relative_url }}">


